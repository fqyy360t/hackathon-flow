# 换行符：Windows 上最容易静默搞坏的一类文件
* text=auto eol=lf

# 脚本必须 LF，否则 sh 报 '\r: command not found'
# 注意：pre-push / pre-commit 没有扩展名，按 basename 匹配才递归生效；
# 只写 ".githooks/*" 的话，钩子放在子目录里就不会命中（实测踩过）。
*.sh            text eol=lf
*.bash          text eol=lf
pre-push        text eol=lf
pre-commit      text eol=lf
commit-msg      text eol=lf
.githooks/*     text eol=lf
**/.githooks/*  text eol=lf

# Windows 批处理必须 CRLF（且需 ANSI/GBK 编码，用 UTF-8 会乱码当命令执行）
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 二进制，不要动
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.mp4           binary
*.pdf           binary
*.xlsx          binary
*.docx          binary
*.pptx          binary
